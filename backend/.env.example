# ─────────────────────────────────────────────────────────────
#  Medical CRM — backend конфигурация
#  Скопируй этот файл в `.env` и при необходимости поправь значения:
#      cp .env.example .env          (bash)
#      Copy-Item .env.example .env   (PowerShell)
#
#  Все переменные имеют дефолты (см. src/config/env.validation.ts),
#  поэтому для локальной разработки .env можно и не создавать —
#  но JWT-секреты ниже дефолтные и для прода НЕ годятся.
# ─────────────────────────────────────────────────────────────

# Окружение: development | test | production
NODE_ENV=development

# Порт HTTP-сервера бэка
PORT=3000

# Префикс для всех маршрутов API (пусто = без префикса, напр. /auth/login).
# Если задать "api", маршруты станут /api/auth/login и т.д.
API_PREFIX=

# Разрешённые источники для CORS. "*" = любой; либо список через запятую.
CORS_ORIGIN=http://localhost:4200

# Строка подключения к MongoDB
MONGODB_URI=mongodb://localhost:27017/medical-crm

# ── JWT ──────────────────────────────────────────────────────
# В production обе переменные ОБЯЗАТЕЛЬНЫ (мин. 16 символов).
# В dev есть дефолты, но лучше задать свои.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please
JWT_REFRESH_EXPIRATION=7d

# Стоимость bcrypt-хеша (10..15)
BCRYPT_SALT_ROUNDS=12

# ── Rate limiting (throttler) ────────────────────────────────
# Окно в миллисекундах и лимит запросов на это окно
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── SMTP (восстановление пароля) ─────────────────────────────
# Не заданы — отправка писем просто отключается (бэк это логирует).
# Для Gmail используй пароль приложения, не основной пароль аккаунта.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Medical CRM <noreply@medicalcrm.com>

# Базовый URL фронта (используется в письмах со ссылками сброса пароля)
FRONTEND_URL=http://localhost:4200
